---
import { Icon } from 'astro-icon/components';

import { portfolioDocument, type ScopeLimit } from '~/data/portfolio-document';

import ArchitectureMap from './ArchitectureMap.astro';
import EvidenceFigure from './EvidenceFigure.astro';
import FlowDiagram from './FlowDiagram.astro';
import PortfolioPage from './PortfolioPage.astro';

const [
  coverPage,
  problemPage,
  evolutionPage,
  currentPage,
  responsibilityPage,
  gjallarPage,
  promotionPage,
  failurePage,
  plannedPage,
  originPage,
  closingPage,
] = portfolioDocument.pages;
const { person, openingStory, projects, closingSummary } = portfolioDocument;

const scopeLimitLabels: Record<ScopeLimit, string> = {
  'release-image-rollback': 'Image rollback · Not implemented',
  'database-backup-restore': 'DB backup / restore · Not implemented',
  'database-purge': 'DB purge · Not implemented',
  'database-credential-rotation': 'Credential rotation · Not implemented',
  'data-rollback': 'User-data rollback · Not implemented',
  'vm-full-lifecycle': 'Full VM lifecycle · Out of scope',
};
---

<main
  class="portfolio-document"
  data-portfolio-document="yunho-cho-platform-engineer-portfolio"
  aria-labelledby="portfolio-document-title"
>
  <h1 id="portfolio-document-title" class="visually-hidden">조윤호 플랫폼 엔지니어 포트폴리오</h1>

  <PortfolioPage {...coverPage}>
    <div class="cover-layout">
      <div class="cover-identity">
        <p class="cover-name">{person.name}</p>
        <p class="cover-role">{person.role}</p>
      </div>
      <ol class="cover-spine" data-diagram="cover-judgement" aria-label="운영 문제를 다루는 네 단계">
        {
          openingStory.spine.map((step, index) => (
            <li class="diagram-node" data-diagram-node={`cover-${index + 1}`}>
              <Icon name={index === 0 ? 'tabler:alert-circle' : index === 3 ? 'tabler:shield-lock' : 'tabler:check'} />
              <strong data-node-title>{step}</strong>
              {index < openingStory.spine.length - 1 && (
                <span
                  class="cover-connector"
                  data-connector-segment
                  data-from-node={`cover-${index + 1}`}
                  data-to-node={`cover-${index + 2}`}
                  aria-hidden="true"
                >
                  <Icon name="tabler:arrow-right" />
                </span>
              )}
            </li>
          ))
        }
      </ol>
      <ul class="cover-contacts" aria-label="연락처">
        {
          person.contacts.map((contact) => (
            <li>
              <a class="contact-link" href={contact.href}>
                {contact.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </PortfolioPage>

  <PortfolioPage {...problemPage}>
    <div class="problem-layout slide-visual" data-primary-visual>
      <FlowDiagram
        steps={openingStory.problem}
        label="새 서비스를 위한 반복 환경 구성 흐름"
        diagram="repeated-environment-loop"
        variant="loop"
        caption="NEXT SERVICE · 같은 준비 흐름으로 복귀"
      />
      <ul class="cost-labels" aria-label="반복 구성의 운영 비용">
        {
          openingStory.costs.map((cost) => (
            <li>
              <>
                <Icon name="tabler:alert-circle" />
                <strong>{cost}</strong>
              </>
            </li>
          ))
        }
      </ul>
    </div>
  </PortfolioPage>

  <PortfolioPage {...evolutionPage}>
    <div class="evolution-layout slide-visual" data-primary-visual>
      <FlowDiagram
        steps={openingStory.evolution}
        label="자동화 범위가 책임 분리로 이어진 과정"
        diagram="automation-evolution"
      />
      <div class="fork-point" data-fork-point aria-hidden="true"><span></span><Icon name="tabler:arrow-down" /></div>
      <div class="evolution-fork" data-diagram="evolution-ownership">
        <article class="diagram-node ownership-result" data-diagram-node="evolution-gjallar">
          <Icon name="tabler:server" />
          <strong data-node-title>Gjallar</strong>
          <span>Infrastructure Create</span>
        </article>
        <span
          class="fork-connector fork-connector--left"
          data-connector-segment
          data-from-node="scope-growth"
          data-to-node="evolution-gjallar"
          aria-hidden="true"></span>
        <article class="diagram-node ownership-result" data-diagram-node="evolution-heimdall">
          <Icon name="tabler:box" />
          <strong data-node-title>Heimdall</strong>
          <span>Application Release</span>
        </article>
        <span
          class="fork-connector fork-connector--right"
          data-connector-segment
          data-from-node="scope-growth"
          data-to-node="evolution-heimdall"
          aria-hidden="true"></span>
      </div>
    </div>
  </PortfolioPage>

  <PortfolioPage {...currentPage}>
    <ArchitectureMap variant="current" label="현재 시스템의 네 가지 책임과 수명주기" />
  </PortfolioPage>

  <PortfolioPage {...responsibilityPage}>
    <div class="responsibility-visual slide-visual" data-primary-visual>
      <div class="responsibility-heading" aria-hidden="true">
        <span>DIMENSION</span><strong>GJALLAR</strong><strong>HEIMDALL</strong>
      </div>
      <dl class="responsibility-grid">
        {
          projects.responsibilitySplit.rows.map((row) => (
            <div data-responsibility-row={row.id}>
              <dt>{row.label}</dt>
              <dd>{row.gjallar}</dd>
              <dd>{row.heimdall}</dd>
            </div>
          ))
        }
      </dl>
      <p class="ownership-statement"><Icon name="tabler:shield-lock" />{projects.responsibilitySplit.statement}</p>
    </div>
  </PortfolioPage>

  <PortfolioPage {...gjallarPage}>
    <div class="gjallar-layout slide-visual" data-primary-visual>
      <div class="gjallar-flow">
        <FlowDiagram
          steps={projects.gjallar.path}
          label="Gjallar 승인 기반 native create 흐름"
          diagram="gjallar-native-create"
        />
        <p class="scope-line" data-scope-limit="vm-full-lifecycle">{projects.gjallar.scopeLimit}</p>
      </div>
      <EvidenceFigure {...projects.gjallar.evidenceFigure} />
    </div>
  </PortfolioPage>

  <PortfolioPage {...promotionPage}>
    <div class="promotion-visual slide-visual" data-primary-visual>
      <section class="promotion-lane" aria-labelledby="candidate-lane-title">
        <h3 id="candidate-lane-title">CANDIDATE · EXECUTION SUCCESS</h3>
        <FlowDiagram
          steps={projects.heimdall.candidate}
          label="Heimdall candidate 실행 흐름"
          diagram="heimdall-candidate"
        />
      </section>
      <section class="promotion-lane" aria-labelledby="activation-lane-title">
        <h3 id="activation-lane-title">ACTIVATION · TRAFFIC SUCCESS</h3>
        <FlowDiagram
          steps={projects.heimdall.activation}
          label="Heimdall 트래픽 활성화 흐름"
          diagram="heimdall-activation"
        />
      </section>
      <p class="retirement-note"><Icon name="tabler:check" />Current 결정 뒤에만 Previous Retirement</p>
    </div>
  </PortfolioPage>

  <PortfolioPage {...failurePage}>
    <div class="failure-visual slide-visual" data-diagram="heimdall-failure-boundary" data-primary-visual>
      <div class="failure-branches">
        {
          projects.heimdall.failureModes.map((mode) => (
            <article class="failure-branch" data-failure-branch={mode.id}>
              <div class="diagram-node failure-node" data-diagram-node={`failure-${mode.id}`}>
                <Icon name="tabler:alert-circle" />
                <strong data-node-title>{mode.failure}</strong>
              </div>
              <span
                class="failure-connector"
                data-connector-segment
                data-from-node={`failure-${mode.id}`}
                data-to-node={`preserved-${mode.id}`}
                aria-hidden="true"
              >
                <Icon name="tabler:arrow-right" />
              </span>
              <div class="diagram-node preserved-node" data-diagram-node={`preserved-${mode.id}`}>
                <span>{mode.handling}</span>
                <strong data-node-title>{mode.preserved}</strong>
              </div>
            </article>
          ))
        }
      </div>
      <div class="data-rail" data-storage-boundary="user-confirmed-operational">
        <span>Runtime generation</span><strong>≠</strong><span>PostgreSQL data lifecycle</span>
        <Icon name="tabler:database" /><small>Separate Storage VM · Operational</small>
      </div>
      <ul class="scope-limit-strip" aria-label="구현하지 않은 복구 범위">
        {
          failurePage.limitations.map((limit: ScopeLimit) => (
            <li data-scope-limit={limit}>{scopeLimitLabels[limit]}</li>
          ))
        }
      </ul>
    </div>
  </PortfolioPage>

  <PortfolioPage {...plannedPage}>
    <ArchitectureMap variant="planned" label="계획된 외부 노출과 내부 데이터 경계" />
  </PortfolioPage>

  <PortfolioPage {...originPage}>
    <div class="transfer-visual slide-visual" data-primary-visual>
      <section class="transfer-pipeline" aria-labelledby="klepaas-title">
        <header><h3 id="klepaas-title">K-Le-PaaS</h3><span>Previous</span></header>
        <FlowDiagram
          steps={projects.klepaas.pipeline}
          label="K-Le-PaaS 입력 정규화 흐름"
          diagram="klepaas-command-plan"
        />
        <div class="transfer-evidence">
          <div class="ownership-notes">
            <p data-team-scope="team"><strong>2인 팀</strong> · 자연어 입력부터 실행 피드백까지</p>
            <p data-team-scope="personal"><strong>개인 기여</strong> · Intent & Entity → CommandPlan 경계</p>
          </div>
          <EvidenceFigure {...projects.klepaas.evidenceFigure} />
        </div>
      </section>
      <section class="transfer-pipeline transfer-pipeline--secondary" aria-labelledby="argus-title">
        <header><h3 id="argus-title">Argus</h3><span>Implemented</span></header>
        <FlowDiagram steps={projects.argus.pipeline} label="Argus 공급자 정규화 흐름" diagram="argus-normalization" />
        <EvidenceFigure {...projects.argus.evidenceFigure} />
      </section>
    </div>
  </PortfolioPage>

  <PortfolioPage {...closingPage}>
    <div class="closing-layout">
      <ol class="project-strip" aria-label="프로젝트별 검증 범위">
        {
          closingSummary.projectSummaries.map((project) => (
            <li data-summary-project={project.id} data-summary-boundary={project.boundary}>
              <span>{project.status}</span>
              <strong>{project.name}</strong>
              <p>{project.summary}</p>
            </li>
          ))
        }
      </ol>
      <dl class="resume-row">
        <div><dt>CORE</dt><dd>{closingSummary.technologies}</dd></div>
        <div><dt>EDUCATION</dt><dd>{closingSummary.education}</dd></div>
        <div><dt>CERTIFICATION</dt><dd>{closingSummary.certifications}</dd></div>
      </dl>
      <ul class="closing-contacts" aria-label="연락처">
        {
          person.contacts.map((contact) => (
            <li>
              <a class="contact-link" href={contact.href}>
                <>
                  <strong>{contact.label}</strong>
                  <span>{contact.value}</span>
                </>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </PortfolioPage>
</main>
