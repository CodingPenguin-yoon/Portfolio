---
import PageLayout from '~/layouts/PageLayout.astro';
import ProjectDetailPage from '~/components/portfolio/ProjectDetailPage.astro';
import { portfolioProjects } from '~/data/portfolio';

export const getStaticPaths = async () =>
  portfolioProjects
    .filter((project) => project.routeGroup === 'projects')
    .map((project) => ({
      params: { slug: project.slug },
      props: {
        project,
        relatedProjects: portfolioProjects.filter((item) => item.slug !== project.slug),
      },
    }));

const { project, relatedProjects } = Astro.props;

const metadata = {
  title: project.fullTitle,
  description: project.seoDescription,
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  <ProjectDetailPage project={project} relatedProjects={relatedProjects} />
</PageLayout>
