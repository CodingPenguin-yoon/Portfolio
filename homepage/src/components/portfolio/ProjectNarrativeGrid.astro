---
import type { ProjectNarrative } from '~/data/portfolio';

export interface Props {
  narrative: ProjectNarrative;
  compact?: boolean;
}

const { narrative, compact = false } = Astro.props;

const items = [
  { label: '문제', text: narrative.problem, accent: 'slate' },
  { label: '구조', text: narrative.structure, accent: 'cyan' },
  { label: '결과', text: narrative.result, accent: 'green' },
];
---

<div class:list={['grid auto-rows-fr gap-3', compact ? 'md:grid-cols-3' : 'lg:grid-cols-3']}>
  {items.map((item) => (
    <article
      class:list={[
        'flex h-full flex-col rounded-[1.2rem] border px-4 py-4',
        item.accent === 'green'
          ? 'border-green-500/20 bg-green-950/10'
          : 'border-slate-800/70 bg-slate-900/58',
      ]}
    >
      <p class:list={['portfolio-eyebrow', item.accent === 'green' ? 'text-green-300' : item.accent === 'cyan' ? 'text-cyan-300' : 'text-slate-300']}>
        {item.label}
      </p>
      <p class="mt-3 text-sm leading-6 text-slate-100/90 [text-wrap:pretty]">{item.text}</p>
    </article>
  ))}
</div>
