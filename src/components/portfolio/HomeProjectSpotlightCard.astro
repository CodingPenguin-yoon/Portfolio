---
import Button from '~/components/ui/Button.astro';
import type { PortfolioProject } from '~/data/portfolio';

export interface Props {
  project: PortfolioProject;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const showGitHub = Boolean(project.repoHref && project.home.secondaryCtaLabel);
const metaItems = [project.projectType, project.period].filter((item): item is string => Boolean(item));
const stackPreview = project.coreStack.slice(0, compact ? 4 : 6);
const steps = project.home.steps ?? [];
const summaryItems = [
  { label: '문제', value: project.narrative.problem, tone: 'default' },
  { label: '구조', value: project.narrative.structure, tone: 'accent' },
  { label: '결과', value: project.narrative.result, tone: 'default' },
];
---

<article class="group relative h-full overflow-hidden rounded-[1.9rem] border border-slate-800/80 bg-slate-950/80 shadow-2xl shadow-slate-950/25">
  <div
    class:list={[
      'absolute inset-0 opacity-90',
      compact
        ? 'bg-[radial-gradient(circle_at_top_right,rgba(34,197,94,0.08),transparent_32%),linear-gradient(180deg,rgba(2,6,23,0.96),rgba(15,23,42,0.92))]'
        : 'bg-[radial-gradient(circle_at_top_left,rgba(6,182,212,0.1),transparent_32%),linear-gradient(135deg,rgba(2,6,23,0.97),rgba(15,23,42,0.92))]',
    ]}
  ></div>

  <div class:list={['relative grid h-full gap-6 p-5 sm:p-6', compact ? 'lg:grid-cols-1' : 'xl:grid-cols-[minmax(0,1.05fr)_minmax(340px,0.95fr)] xl:items-start']}>
    <div class="flex h-full flex-col justify-between">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class:list={['portfolio-eyebrow', compact ? 'text-green-300' : 'text-cyan-300']}>{project.home.eyebrow}</span>
          {metaItems.map((item) => (
            <span class="rounded-full border border-slate-700/80 bg-slate-900/72 px-3 py-1 text-[11px] font-mono uppercase tracking-[0.16em] text-slate-300">
              {item}
            </span>
          ))}
        </div>

        <h3 class:list={['mt-4 font-bold tracking-tight text-slate-50 [text-wrap:balance]', compact ? 'text-[2rem] sm:text-[2.2rem]' : 'text-[2.25rem] sm:text-[2.7rem]']}>
          {project.title}
        </h3>
        <p class="mt-2 text-base font-medium leading-7 text-cyan-100/84 [text-wrap:pretty]">{project.tagline}</p>
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-300/84 [text-wrap:pretty]">{project.home.summary}</p>

        <div class="mt-6 grid gap-3">
          {summaryItems.map((item) => (
            <article class:list={['rounded-[1.2rem] border px-4 py-4', item.tone === 'accent' ? 'border-green-500/20 bg-green-950/10' : 'border-slate-800/80 bg-slate-900/60']}>
              <p class:list={['text-[11px] font-mono uppercase tracking-[0.16em]', item.tone === 'accent' ? 'text-green-300' : 'text-slate-400']}>{item.label}</p>
              <p class="mt-2 text-sm leading-6 text-slate-100/90 [text-wrap:pretty]">{item.value}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="mt-6">
        {steps.length ? (
          <div>
            <p class="text-[11px] font-mono uppercase tracking-[0.16em] text-slate-500">흐름</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {steps.map((step, index) => (
                <span class="inline-flex items-center gap-2 rounded-full border border-slate-700/80 bg-slate-900/72 px-3 py-1.5 text-xs text-slate-200">
                  <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-cyan-300">{index + 1}</span>
                  {step}
                </span>
              ))}
            </div>
          </div>
        ) : null}

        <div class="mt-5 flex flex-wrap gap-2">
          {stackPreview.map((stack) => (
            <span class="portfolio-chip">{stack}</span>
          ))}
        </div>

        <div class="mt-6 flex flex-wrap gap-3">
          <Button variant="primary" href={project.directHref}>
            {project.home.primaryCtaLabel}
          </Button>
          {showGitHub ? (
            <Button variant="secondary" href={project.repoHref} target="_blank">
              {project.home.secondaryCtaLabel}
            </Button>
          ) : null}
        </div>
      </div>
    </div>

    <div class="flex h-full flex-col">
      {project.visual.src ? (
        <figure class="shrink-0 overflow-hidden rounded-[1.5rem] border border-slate-800/80 bg-slate-950/92">
          <div class="flex items-center justify-between border-b border-slate-800/75 px-4 py-3">
            <span class="text-[11px] font-mono uppercase tracking-[0.16em] text-slate-400">{project.visual.label}</span>
            <span class:list={['portfolio-eyebrow', compact ? 'text-cyan-300' : 'text-green-300']}>{project.projectType}</span>
          </div>
          <div class="bg-slate-950/80 p-3">
            <img
              src={project.visual.src}
              alt={project.visual.alt}
              class="block h-auto w-full rounded-[0.95rem] object-contain object-top transition duration-500 group-hover:scale-[1.015]"
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
      ) : null}

      <article class="mt-4 flex flex-1 flex-col rounded-[1.2rem] border border-slate-800/80 bg-slate-900/60 px-4 py-4">
        <p class="text-[11px] font-mono uppercase tracking-[0.16em] text-slate-500">화면 요약</p>
        <p class="mt-2 text-sm leading-6 text-slate-100/88 [text-wrap:pretty]">{project.visual.caption}</p>
        <div class="mt-4 grid gap-2 sm:grid-cols-2">
          <div class="rounded-[1rem] border border-slate-800/80 bg-slate-950/72 px-3 py-3">
            <p class="text-[11px] font-mono uppercase tracking-[0.16em] text-slate-500">역할</p>
            <p class="mt-2 text-sm leading-6 text-slate-200/88 [text-wrap:pretty]">{project.role}</p>
          </div>
          <div class="rounded-[1rem] border border-slate-800/80 bg-slate-950/72 px-3 py-3">
            <p class="text-[11px] font-mono uppercase tracking-[0.16em] text-slate-500">결과 흐름</p>
            <p class="mt-2 text-sm leading-6 text-slate-200/88 [text-wrap:pretty]">{project.resultLine}</p>
          </div>
        </div>
      </article>
    </div>
  </div>
</article>
