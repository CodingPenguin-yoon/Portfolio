---
import type { DocumentStatus } from '~/data/portfolio-document';

import StatusBadge from './StatusBadge.astro';

export interface Props {
  number: number;
  slug: string;
  eyebrow: string;
  title: string;
  subline?: string;
  status?: DocumentStatus;
  statusNote?: string;
}

const { number, slug, eyebrow, title, subline, status, statusNote } = Astro.props;
const titleId = `portfolio-page-${number}-title`;
---

<section
  class="portfolio-page"
  data-portfolio-page={number}
  data-page-slug={slug}
  data-page-status={status}
  aria-labelledby={titleId}
>
  <header class="page-header">
    <p class="page-eyebrow">{eyebrow}</p>
    {status && <StatusBadge status={status} note={statusNote} />}
  </header>
  <h2 id={titleId}>{title}</h2>
  {subline && <p class="page-subline">{subline}</p>}
  <div class="slide-body"><slot /></div>
  <footer class="page-footer">
    <span>YUNHO CHO · PLATFORM ENGINEER</span>
    <span data-page-number>{String(number).padStart(2, '0')} / 14</span>
  </footer>
</section>
