---
import type { FlowStepData } from '~/data/portfolio-document';

export type FlowSteps = readonly FlowStepData[];

export interface Props {
  steps: FlowSteps;
  label: string;
  caption?: string;
}

const { steps, label, caption } = Astro.props;
---

<figure class="flow-diagram" data-flow-diagram>
  <ol aria-label={label}>
    {
      steps.map((step, index) => (
        <li data-flow-step={step.id}>
          <>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{step.label}</strong>
            {step.summary && <small>{step.summary}</small>}
            {step.operations && (
              <ul class="flow-step-operations" aria-label={`${step.label} 세부 작업`}>
                {step.operations.map((operation) => (
                  <li data-flow-operation={operation.id}>{operation.label}</li>
                ))}
              </ul>
            )}
          </>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
