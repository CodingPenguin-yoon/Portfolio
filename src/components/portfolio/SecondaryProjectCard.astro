---
import Button from '~/components/ui/Button.astro';
import ProjectNarrativeGrid from '~/components/portfolio/ProjectNarrativeGrid.astro';
import type { PortfolioProject } from '~/data/portfolio';

export interface Props {
  project: PortfolioProject;
}

const { project } = Astro.props;
const showGitHub = Boolean(project.repoHref && project.home.secondaryCtaLabel);
---

<article class="portfolio-card overflow-hidden">
  <div class="grid gap-5 lg:grid-cols-[minmax(0,1.04fr)_minmax(320px,0.96fr)] lg:items-start">
    <div>
      <p class="portfolio-eyebrow text-green-300">{project.home.eyebrow}</p>
      <h3 class="mt-3 text-[1.8rem] font-bold tracking-tight text-slate-50 sm:text-[2.05rem] sm:leading-[1.08] [text-wrap:balance]">
        {project.fullTitle}
      </h3>
      <p class="mt-4 max-w-[40rem] text-base leading-7 text-slate-200/90 [text-wrap:pretty]">{project.home.summary}</p>
      {project.home.supporting ? <p class="mt-3 text-sm leading-6 text-green-200/82 [text-wrap:pretty]">{project.home.supporting}</p> : null}
    </div>

    <div class="grid gap-3">
      {project.visual.src ? (
        <figure class="overflow-hidden rounded-[1.35rem] border border-slate-800/75 bg-slate-900/72">
          <div class="flex items-center justify-between border-b border-slate-800/75 px-4 py-3">
            <span class="text-[11px] font-mono uppercase tracking-[0.16em] text-slate-400">{project.visual.label}</span>
            <span class="portfolio-eyebrow text-cyan-300">{project.projectType}</span>
          </div>
          <img src={project.visual.src} alt={project.visual.alt} class="aspect-[16/10] w-full object-cover object-top" />
        </figure>
      ) : null}

      {project.home.steps?.length ? (
        <div class="grid gap-2">
          {project.home.steps.map((item, index) => (
            <div class="portfolio-meta text-sm leading-6 text-slate-200/88">
              <span class="mr-2 font-mono text-green-300">{index + 1}.</span>
              {item}
            </div>
          ))}
        </div>
      ) : null}
    </div>
  </div>

  <div class="mt-5">
    <ProjectNarrativeGrid narrative={project.narrative} compact />
  </div>

  <div class="mt-5 flex flex-col gap-4 border-t border-slate-800/70 pt-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap gap-2">
      {project.coreStack.map((stack) => (
        <span class="portfolio-chip">{stack}</span>
      ))}
    </div>

    <div class="flex flex-wrap gap-3">
      <Button variant="primary" href={project.directHref}>
        {project.home.primaryCtaLabel}
      </Button>
      {showGitHub ? (
        <Button variant="secondary" href={project.repoHref} target="_blank">
          {project.home.secondaryCtaLabel}
        </Button>
      ) : null}
    </div>
  </div>
</article>
