---
import type { SignatureFlow } from '~/data/portfolio';

export interface Props {
  flow: SignatureFlow;
  compact?: boolean;
}

const { flow, compact = false } = Astro.props;

const labelsByKind = {
  provisioning: ['요청', '클론', '프로비저닝', '추적'],
  'request-execution': ['요청', '라우팅', '실행 대상', '피드백'],
  'source-to-question': ['수집', '정규화', '질문 UI'],
} as const;

const accentIndexByKind = {
  provisioning: 3,
  'request-execution': 1,
  'source-to-question': 2,
} as const;

const labels = labelsByKind[flow.kind];
const accentIndex = accentIndexByKind[flow.kind];
---

<section class:list={['portfolio-card', compact ? 'p-5' : 'p-6 sm:p-7']}>
  <div class:list={[compact ? 'max-w-none' : 'max-w-3xl']}>
    <p class="portfolio-eyebrow text-green-300">{flow.eyebrow}</p>
    <h2 class:list={[compact ? 'mt-3 text-xl font-semibold tracking-tight text-slate-50 sm:text-[1.55rem]' : 'mt-3 text-2xl font-semibold tracking-tight text-slate-50 sm:text-[2rem]']}>
      {flow.title}
    </h2>
    <p class:list={[compact ? 'mt-3 text-sm leading-6 text-slate-300/84' : 'mt-4 max-w-2xl text-base leading-7 text-slate-300/86']}>
      {flow.description}
    </p>
  </div>

  <div
    class:list={[
      'mt-5 grid auto-rows-fr gap-3',
      flow.kind === 'source-to-question'
        ? compact
          ? 'md:grid-cols-3'
          : 'lg:grid-cols-3'
        : compact
          ? 'sm:grid-cols-2'
          : 'md:grid-cols-2 xl:grid-cols-4',
    ]}
  >
    {flow.steps.map((step, index) => (
      <article
        class:list={[
          'flex h-full flex-col rounded-[1.25rem] border px-4 py-4',
          index === accentIndex ? 'border-green-500/20 bg-green-950/10' : 'border-slate-800/70 bg-slate-900/58',
        ]}
      >
        <p class:list={['portfolio-eyebrow', index === accentIndex ? 'text-green-300' : 'text-cyan-300']}>{labels[index]}</p>
        <h3 class="mt-3 text-base font-semibold tracking-tight text-slate-50">{step.title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-300/84">{step.description}</p>
      </article>
    ))}
  </div>
</section>
