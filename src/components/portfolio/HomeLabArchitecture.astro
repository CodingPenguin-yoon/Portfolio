---
import { Icon } from 'astro-icon/components';

const zones = [
  {
    id: 'red',
    label: 'RED',
    title: 'Test',
    nic: 'NIC 2',
    items: ['Internal Heimdall', 'DNS + Reverse Proxy'],
  },
  {
    id: 'green',
    label: 'GREEN',
    title: 'Management / Storage',
    nic: 'NIC 1',
    items: ['Proxmox · 3 Nodes', 'NAS + NFS VM'],
  },
  {
    id: 'orange',
    label: 'ORANGE',
    title: 'DMZ / Public Services',
    nic: 'NIC 3',
    items: ['WireGuard Gateway', 'Public Service VMs'],
  },
] as const;
---

<section id="infrastructure" class="infrastructure-page" aria-labelledby="infrastructure-title">
  <div class="infrastructure-inner">
    <header class="infrastructure-heading">
      <p>My infrastructure</p>
      <div>
        <h2 id="infrastructure-title">Inside My Home Lab.</h2>
        <p>외부 서비스는 OCI와 WireGuard를 거쳐 ORANGE로 연결하고, IPFire로 각 영역의 접근을 분리했습니다.</p>
      </div>
    </header>

    <div class="architecture-board">
      <div class="board-toolbar">
        <div class="board-lights" aria-hidden="true"><i></i><i></i><i></i></div>
        <span>HOME LAB / NETWORK ARCHITECTURE</span>
        <span class="live-status"><i></i>LIVE</span>
      </div>

      <div class="board-content">
        <header class="board-heading">
          <h3>지금 운영하고 있는 구조</h3>
        </header>

        <ol class="external-route" aria-label="외부 서비스 접근 경로">
          <li><Icon name="tabler:users" /><span>Client</span></li>
          <li aria-hidden="true"><Icon name="tabler:arrow-right" /></li>
          <li><Icon name="tabler:cloud" /><span>OCI Reverse Proxy</span></li>
          <li aria-hidden="true"><Icon name="tabler:arrow-right" /></li>
          <li><Icon name="tabler:shield-lock" /><span>WireGuard</span></li>
          <li aria-hidden="true"><Icon name="tabler:arrow-right" /></li>
          <li><Icon name="tabler:server" /><span>ORANGE</span></li>
        </ol>

        <div class="firewall-row">
          <span><Icon name="tabler:shield-check" /><strong>IPFire</strong> · Network boundary</span>
          <span>RED → ORANGE 허용 · ORANGE → RED / GREEN 차단</span>
        </div>

        <div class="zone-grid">
          {
            zones.map((zone) => (
              <article class:list={['zone', `zone-${zone.id}`]}>
                <header>
                  <span>{zone.label}</span>
                  <div>
                    <h3>{zone.title}</h3>
                    <p>{zone.nic}</p>
                  </div>
                </header>
                <ul>
                  {zone.items.map((item: string) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .infrastructure-page {
    min-height: calc(100svh - 5rem);
    scroll-margin-top: 0;
    border-bottom: 1px solid #111214;
    background: #f4f1e9;
    color: #111214;
  }

  .infrastructure-inner {
    display: flex;
    min-height: calc(100svh - 5rem);
    width: min(100% - 2rem, 92rem);
    flex-direction: column;
    justify-content: center;
    margin: 0 auto;
    padding: 3rem 0;
  }

  .infrastructure-heading {
    display: grid;
    grid-template-columns: 0.7fr 2fr;
    gap: 4rem;
  }

  .infrastructure-heading > p,
  .board-toolbar,
  .firewall-row,
  .zone header > span,
  .zone header p {
    font-family: var(--aw-font-mono);
    text-transform: uppercase;
  }

  .infrastructure-heading > p {
    margin: 0;
    font-size: 0.7rem;
  }

  .infrastructure-heading h2 {
    margin: 0;
    color: inherit;
    font-family: var(--aw-font-sans), sans-serif;
    font-size: clamp(2.5rem, 4vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .infrastructure-heading div > p {
    max-width: 50rem;
    margin: 1.25rem 0 0;
    color: #55575d;
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .architecture-board {
    overflow: hidden;
    margin-top: 2.5rem;
    border: 2px solid #111214;
    border-radius: 4px;
    background: #ffffff;
    color: #111214;
    box-shadow: 0.8rem 0.8rem 0 #111214;
  }

  .board-toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 3.4rem;
    align-items: center;
    border-bottom: 2px solid #111214;
    background: #0c0d10;
    color: #ffffff;
    padding: 0 1.25rem;
    font-size: 0.62rem;
  }

  .board-lights,
  .live-status {
    display: flex;
    align-items: center;
  }

  .board-lights {
    gap: 0.4rem;
  }

  .board-lights i {
    width: 0.6rem;
    height: 0.6rem;
    border: 1px solid #ffffff;
    border-radius: 50%;
  }

  .board-lights i:nth-child(1) {
    background: #ee5648;
  }
  .board-lights i:nth-child(2) {
    background: #f2bd35;
  }
  .board-lights i:nth-child(3) {
    background: #159865;
  }

  .live-status {
    justify-self: end;
    gap: 0.4rem;
  }

  .live-status i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #49d17d;
  }

  .board-content {
    padding: 2rem;
  }

  .board-heading {
    display: block;
  }

  .board-heading h3 {
    margin: 0;
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .external-route {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    margin: 1.75rem 0;
    padding: 0;
    list-style: none;
  }

  .external-route li:nth-child(odd) {
    display: flex;
    min-height: 4rem;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid #111214;
    border-radius: 3px;
    background: #f7f5ee;
    padding: 0.75rem 1rem;
    font-size: 0.76rem;
    font-weight: 650;
  }

  .external-route li:nth-child(even) {
    display: grid;
    place-items: center;
  }

  .external-route :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .firewall-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #111214;
    color: #ffffff;
    padding: 0.85rem 1.25rem;
    font-size: 0.62rem;
  }

  .firewall-row span:first-child {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .firewall-row span:last-child {
    color: #b9bcc4;
  }

  .firewall-row :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .zone-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  .zone {
    --zone-color: #ee5648;
    border: 1px solid #111214;
    border-radius: 3px;
    background: #ffffff;
  }

  .zone-green {
    --zone-color: #159865;
  }
  .zone-orange {
    --zone-color: #f2bd35;
  }

  .zone header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: center;
    border-bottom: 1px solid #111214;
    padding: 1rem;
  }

  .zone header > span {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border: 1px solid #111214;
    background: var(--zone-color);
    font-size: 0.58rem;
    font-weight: 600;
  }

  .zone h3 {
    margin: 0;
    color: inherit;
    font-size: 0.95rem;
    font-weight: 650;
  }

  .zone header p {
    margin: 0.35rem 0 0;
    color: #66686f;
    font-size: 0.55rem;
  }

  .zone ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zone li {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    border-bottom: 1px solid #d1cec5;
    padding: 0.75rem 1rem;
    font-size: 0.72rem;
  }

  .zone li:last-child {
    border-bottom: 0;
  }

  @media (max-width: 900px) {
    .infrastructure-heading {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .external-route,
    .zone-grid {
      grid-template-columns: 1fr;
    }

    .external-route li:nth-child(even) {
      transform: rotate(90deg);
    }

    .zone {
      border: 1px solid #111214;
    }
  }

  @media (max-width: 639px) {
    .infrastructure-page,
    .infrastructure-inner {
      min-height: 0;
    }

    .infrastructure-inner {
      padding: 5rem 0;
    }

    .infrastructure-heading h2 {
      font-size: 2.5rem;
    }

    .architecture-board {
      margin-top: 2rem;
      box-shadow: 0.5rem 0.5rem 0 #111214;
    }

    .board-toolbar {
      grid-template-columns: auto 1fr;
      gap: 1rem;
    }

    .board-toolbar > span:first-of-type {
      text-align: right;
    }

    .live-status {
      display: none;
    }

    .board-content {
      padding: 1.25rem;
    }

    .firewall-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .zone ul {
      grid-template-columns: 1fr;
    }

    .zone li {
      border-right: 0;
      border-bottom: 1px solid #d1cec5;
    }

    .zone li:last-child {
      border-bottom: 0;
    }
  }
</style>
