---
import { Icon } from 'astro-icon/components';

const currentZones = [
  {
    id: 'red',
    label: 'RED',
    title: 'Home LAN / Test',
    nic: 'NIC 2 · Upstream gateway',
    items: [
      { icon: 'tabler:router', label: 'Home router network' },
      { icon: 'tabler:rocket', label: 'Heimdall · internal deployment' },
      { icon: 'tabler:world-www', label: 'DNS + Reverse Proxy · same VM' },
    ],
  },
  {
    id: 'green',
    label: 'GREEN',
    title: 'Management / Storage',
    nic: 'NIC 1 · Proxmox host IP',
    items: [
      { icon: 'tabler:server-2', label: 'Proxmox cluster · 3 nodes' },
      { icon: 'tabler:database', label: 'NAS storage' },
      { icon: 'tabler:database-cog', label: 'NFS VM · disk passthrough' },
    ],
  },
  {
    id: 'orange',
    label: 'ORANGE',
    title: 'DMZ / Public Services',
    nic: 'NIC 3 · bridge only, no host IP',
    items: [
      { icon: 'tabler:shield-lock', label: 'WireGuard gateway' },
      { icon: 'tabler:server', label: 'Public service VMs' },
      { icon: 'tabler:lock', label: 'No access to GREEN' },
    ],
  },
] as const;

const targetZones = [
  {
    id: 'red',
    label: 'RED',
    title: 'Test Zone',
    status: 'Keep testing',
    items: ['Internal Heimdall', 'Deployment validation'],
  },
  {
    id: 'green',
    label: 'GREEN',
    title: 'Trusted Operation',
    status: 'Migration planned',
    items: ['DNS + Reverse Proxy', 'Proxmox management', 'NAS + NFS'],
  },
  {
    id: 'orange',
    label: 'ORANGE',
    title: 'Isolated Execution',
    status: 'In development',
    items: ['Heimdall external Worker', 'WireGuard gateway', 'Public service VMs'],
  },
] as const;
---

<section id="origin" class="origin-section" aria-labelledby="origin-title">
  <div class="origin-inner">
    <div class="origin-heading">
      <p class="origin-label">Where it started / Home lab</p>
      <div>
        <h2 id="origin-title">운영에서 시작한 자동화.</h2>
        <p class="origin-intro">
          Proxmox 3노드 홈랩을 운영하며 반복되는 배포와 인프라 구성을 자동화했습니다. 관리·테스트·외부 서비스 영역은
          분리하고, 필요한 접근만 허용했습니다. Heimdall과 내부 DNS, 리버스 프록시도 이 과정에서 만들었습니다.
        </p>
      </div>
    </div>

    <div class="origin-principle">
      <span>Operating principle</span>
      <div>
        <h3>배포 이후까지 설계합니다.</h3>
        <p>서비스 실행뿐 아니라 DNS, 접근 경로, 상태 확인까지 배포 과정에 포함합니다.</p>
      </div>
    </div>

    <div class="architecture-frame">
      <div class="frame-toolbar">
        <div class="frame-lights" aria-hidden="true"><i></i><i></i><i></i></div>
        <span>HOME LAB / NETWORK ARCHITECTURE</span>
        <div class="status-legend" aria-label="상태 범례">
          <span><i class="live"></i>Current</span>
          <span><i class="planned"></i>Planned</span>
        </div>
      </div>

      <article class="architecture-state current-state" aria-labelledby="current-title">
        <header class="state-heading">
          <div>
            <span>01 / Current architecture</span>
            <h3 id="current-title">지금 운영하고 있는 구조</h3>
          </div>
          <span class="state-badge live-badge">Live</span>
        </header>

        <ol class="external-route" aria-label="외부 서비스 요청 경로">
          <li><Icon name="tabler:users" /><span>Client</span></li>
          <li class="route-arrow" aria-hidden="true"><Icon name="tabler:arrow-right" /></li>
          <li><Icon name="tabler:cloud" /><span>OCI Reverse Proxy</span></li>
          <li class="route-arrow" aria-hidden="true"><Icon name="tabler:arrow-right" /></li>
          <li><Icon name="tabler:shield-lock" /><span>WireGuard Tunnel</span></li>
          <li class="route-arrow" aria-hidden="true"><Icon name="tabler:arrow-right" /></li>
          <li><Icon name="tabler:server" /><span>ORANGE Service VM</span></li>
        </ol>

        <div class="firewall-bar">
          <div>
            <Icon name="tabler:shield-check" />
            <span><strong>IPFire</strong> · network boundary</span>
          </div>
          <p>RED → ORANGE 제한 허용 · ORANGE → RED / GREEN 차단</p>
        </div>

        <div class="zone-grid current-zones">
          {
            currentZones.map((zone) => (
              <section class:list={['zone-card', `zone-${zone.id}`]} aria-labelledby={`current-${zone.id}`}>
                <header>
                  <span>{zone.label}</span>
                  <div>
                    <h4 id={`current-${zone.id}`}>{zone.title}</h4>
                    <p>{zone.nic}</p>
                  </div>
                </header>
                <ul>
                  {zone.items.map((item: (typeof currentZones)[number]['items'][number]) => (
                    <li>
                      <Icon name={item.icon} />
                      <span>{item.label}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </article>

      <article class="architecture-state target-state" aria-labelledby="target-title">
        <header class="state-heading">
          <div>
            <span>02 / Target architecture</span>
            <h3 id="target-title">검증에서 운영으로.</h3>
          </div>
          <span class="state-badge planned-badge">In progress</span>
        </header>

        <div class="zone-grid target-zones">
          {
            targetZones.map((zone) => (
              <section class:list={['zone-card', `zone-${zone.id}`]} aria-labelledby={`target-${zone.id}`}>
                <header>
                  <span>{zone.label}</span>
                  <div>
                    <h4 id={`target-${zone.id}`}>{zone.title}</h4>
                    <p>{zone.status}</p>
                  </div>
                </header>
                <ul>
                  {zone.items.map((item: string) => (
                    <li>
                      <Icon name="tabler:circle-dashed" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>

        <ol class="evolution-flow" aria-label="홈랩 구조 개선 과정">
          <li><span>01</span><strong>Deploy</strong><p>RED에서 내부 배포 흐름을 검증합니다.</p></li>
          <li><span>02</span><strong>Make it reachable</strong><p>DNS와 Reverse Proxy로 접근 경로를 만듭니다.</p></li>
          <li>
            <span>03</span><strong>Separate</strong><p>DNS·Reverse Proxy는 GREEN, 외부 실행은 ORANGE로 분리합니다.</p>
          </li>
          <li><span>04</span><strong>Automate safely</strong><p>ORANGE에는 권한이 제한된 Worker만 배치합니다.</p></li>
        </ol>
      </article>
    </div>
  </div>
</section>

<style>
  .origin-section {
    border-bottom: 1px solid #111214;
    background: #f4f1e9;
    color: #111214;
  }

  .origin-inner {
    width: min(100% - 2rem, 92rem);
    margin: 0 auto;
    padding: 6rem 0 7rem;
  }

  .origin-heading {
    display: grid;
    grid-template-columns: 0.7fr 2fr;
    gap: 4rem;
  }

  .origin-label,
  .frame-toolbar,
  .state-heading > div > span,
  .state-badge,
  .zone-card header > span,
  .zone-card header p,
  .evolution-flow span,
  .origin-principle > span {
    font-family: var(--aw-font-mono);
    text-transform: uppercase;
  }

  .origin-label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 500;
  }

  .origin-heading h2 {
    max-width: 58rem;
    margin: 0;
    font-family: var(--aw-font-sans), sans-serif;
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.06;
    word-break: keep-all;
  }

  .origin-intro {
    max-width: 50rem;
    margin: 2rem 0 0;
    color: #4e5056;
    font-size: 1.05rem;
    line-height: 1.8;
    word-break: keep-all;
  }

  .origin-principle {
    display: grid;
    grid-template-columns: 0.7fr 2fr;
    gap: 4rem;
    margin: 4rem 0 2.5rem;
    border-top: 1px solid #111214;
    padding: 2rem 0 0;
  }

  .origin-principle > span {
    font-size: 0.68rem;
  }

  .origin-principle h3 {
    max-width: 66rem;
    margin: 0;
    font-size: clamp(1.4rem, 2.4vw, 2.15rem);
    font-weight: 600;
    line-height: 1.35;
    word-break: keep-all;
  }

  .origin-principle p {
    max-width: 48rem;
    margin: 0.75rem 0 0;
    color: #4e5056;
    font-size: 0.95rem;
    line-height: 1.7;
    word-break: keep-all;
  }

  .architecture-frame {
    overflow: hidden;
    border: 2px solid #111214;
    border-radius: 4px;
    background: #ffffff;
    box-shadow: 1rem 1rem 0 #111214;
  }

  .frame-toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 3.5rem;
    border-bottom: 2px solid #111214;
    background: #0c0d10;
    color: #ffffff;
    padding: 0 1.25rem;
    font-size: 0.68rem;
  }

  .frame-lights,
  .status-legend,
  .status-legend span {
    display: flex;
    align-items: center;
  }

  .frame-lights {
    gap: 0.4rem;
  }

  .frame-lights i,
  .status-legend i {
    display: block;
    border-radius: 50%;
  }

  .frame-lights i {
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid #ffffff;
  }

  .frame-lights i:nth-child(1) {
    background: #ee5648;
  }
  .frame-lights i:nth-child(2) {
    background: #f2bd35;
  }
  .frame-lights i:nth-child(3) {
    background: #159865;
  }

  .status-legend {
    justify-content: flex-end;
    gap: 1.25rem;
  }

  .status-legend span {
    gap: 0.4rem;
  }

  .status-legend i {
    width: 0.5rem;
    height: 0.5rem;
  }

  .status-legend .live {
    background: #49d17d;
  }
  .status-legend .planned {
    border: 1px dashed #ffffff;
  }

  .architecture-state {
    padding: 2.5rem;
  }

  .architecture-state + .architecture-state {
    border-top: 2px solid #111214;
  }

  .target-state {
    background: #ece9e0;
  }

  .state-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .state-heading > div > span {
    color: #66686f;
    font-size: 0.66rem;
  }

  .state-heading h3 {
    margin: 0.6rem 0 0;
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .state-badge {
    border: 1px solid #111214;
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    font-size: 0.62rem;
  }

  .live-badge {
    background: #d8f6e4;
  }
  .planned-badge {
    border-style: dashed;
    background: #ffffff;
  }

  .external-route {
    display: grid;
    grid-template-columns: 1fr auto 1.4fr auto 1.4fr auto 1.4fr;
    gap: 0.75rem;
    align-items: center;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }

  .external-route li:not(.route-arrow) {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid #111214;
    border-radius: 4px;
    background: #f7f5ee;
    padding: 0.8rem 1rem;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .external-route :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
  }

  .route-arrow {
    display: grid;
    place-items: center;
  }

  .firewall-bar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: center;
    border: 2px solid #111214;
    background: #111214;
    color: #ffffff;
    padding: 1rem 1.25rem;
  }

  .firewall-bar > div {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    white-space: nowrap;
  }

  .firewall-bar p {
    margin: 0;
    color: #c7cad2;
    font-family: var(--aw-font-mono);
    font-size: 0.66rem;
    text-align: right;
  }

  .firewall-bar :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .zone-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .zone-card {
    min-width: 0;
    border-right: 1px solid #111214;
    border-bottom: 1px solid #111214;
  }

  .zone-card:first-child {
    border-left: 1px solid #111214;
  }

  .zone-card > header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    min-height: 6.75rem;
    align-items: start;
    border-bottom: 1px solid #111214;
    padding: 1.25rem;
  }

  .zone-card header > span {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid #111214;
    background: var(--zone-color);
    font-size: 0.63rem;
    font-weight: 600;
  }

  .zone-card h4 {
    margin: 0;
    font-size: 1rem;
    font-weight: 650;
  }

  .zone-card header p {
    margin: 0.5rem 0 0;
    color: #66686f;
    font-size: 0.58rem;
    line-height: 1.4;
  }

  .zone-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zone-card li {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid #d1cec5;
    padding: 0.75rem 1.25rem;
    font-size: 0.78rem;
  }

  .zone-card li:last-child {
    border-bottom: 0;
  }

  .zone-card li :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .zone-red {
    --zone-color: #ee5648;
  }
  .zone-green {
    --zone-color: #159865;
  }
  .zone-orange {
    --zone-color: #f2bd35;
  }

  .target-zones {
    margin-top: 2rem;
  }

  .target-zones .zone-card {
    border-style: dashed;
    background: rgba(255, 255, 255, 0.58);
  }

  .target-zones .zone-card > header,
  .target-zones .zone-card li {
    border-style: dashed;
  }

  .evolution-flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 2.5rem 0 0;
    padding: 0;
    border: 1px solid #111214;
    background: #ffffff;
    list-style: none;
  }

  .evolution-flow li {
    min-height: 9rem;
    border-right: 1px solid #111214;
    padding: 1.25rem;
  }

  .evolution-flow li:last-child {
    border-right: 0;
  }

  .evolution-flow span {
    display: block;
    color: #66686f;
    font-size: 0.64rem;
  }

  .evolution-flow strong {
    display: block;
    margin-top: 1.5rem;
    font-size: 0.92rem;
  }

  .evolution-flow p {
    margin: 0.5rem 0 0;
    color: #55575d;
    font-size: 0.74rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .origin-heading,
    .origin-principle {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .external-route {
      grid-template-columns: 1fr;
    }

    .route-arrow {
      transform: rotate(90deg);
    }

    .firewall-bar {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .firewall-bar p {
      text-align: left;
    }

    .zone-grid {
      grid-template-columns: 1fr;
    }

    .zone-card,
    .zone-card:first-child {
      border-left: 1px solid #111214;
    }

    .evolution-flow {
      grid-template-columns: repeat(2, 1fr);
    }
    .evolution-flow li:nth-child(2) {
      border-right: 0;
    }
    .evolution-flow li:nth-child(-n + 2) {
      border-bottom: 1px solid #111214;
    }
  }

  @media (max-width: 639px) {
    .origin-inner {
      padding: 4.5rem 0 5rem;
    }
    .origin-heading h2 {
      font-size: 2.5rem;
    }
    .origin-intro {
      font-size: 0.95rem;
    }
    .origin-principle {
      margin-top: 3rem;
    }
    .origin-principle h3 {
      font-size: 1.35rem;
    }

    .architecture-frame {
      box-shadow: 0.5rem 0.5rem 0 #111214;
    }

    .frame-toolbar {
      grid-template-columns: auto 1fr;
      gap: 1rem;
      min-height: 4rem;
    }

    .frame-toolbar > span {
      text-align: right;
    }
    .status-legend {
      display: none;
    }
    .architecture-state {
      padding: 1.25rem;
    }
    .state-heading {
      flex-direction: column-reverse;
      gap: 1rem;
    }
    .state-heading h3 {
      font-size: 1.65rem;
    }
    .state-badge {
      align-self: flex-end;
      flex: 0 0 auto;
    }

    .external-route li:not(.route-arrow) {
      min-height: 3.75rem;
    }

    .firewall-bar > div {
      white-space: normal;
    }

    .evolution-flow {
      grid-template-columns: 1fr;
    }
    .evolution-flow li,
    .evolution-flow li:nth-child(2) {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid #111214;
    }
    .evolution-flow li:last-child {
      border-bottom: 0;
    }
  }
</style>
