---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  accent?: 'cyan' | 'green' | 'slate';
  class?: string;
}

const { eyebrow, title, description, accent = 'cyan', class: className = '' } = Astro.props;

const accentClass = {
  cyan: 'text-cyan-300',
  green: 'text-green-300',
  slate: 'text-slate-400',
}[accent];
---

<div class:list={['max-w-[42rem]', className]}>
  {eyebrow ? <p class:list={['portfolio-eyebrow', accentClass]}>{eyebrow}</p> : null}
  <h2 class="mt-3 text-[1.95rem] font-bold tracking-tight text-slate-50 sm:text-[2.4rem] sm:leading-[1.08] [text-wrap:balance]">{title}</h2>
  {description ? <p class="mt-3 max-w-[40rem] text-base leading-7 text-slate-300/84 [text-wrap:pretty]">{description}</p> : null}
</div>
