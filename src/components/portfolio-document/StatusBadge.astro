---
import type { DocumentStatus } from '~/data/portfolio-document';

export interface Props {
  status: DocumentStatus;
  note?: string;
}

const { status, note } = Astro.props;

const statusLabels: Record<DocumentStatus, string> = {
  implemented: 'Implemented',
  previous: 'Previous',
  planned: 'Planned',
};
---

<div class="status-summary" data-status={status}>
  <span class="status-badge">{statusLabels[status]}</span>
  {note && <p class="status-note">{note}</p>}
</div>
