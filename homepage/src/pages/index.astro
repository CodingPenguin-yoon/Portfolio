---
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import HomeProjectSpotlightCard from '~/components/portfolio/HomeProjectSpotlightCard.astro';
import { mainProjects, portfolioActionLinks, portfolioHome, portfolioProfile, portfolioProjects, secondaryProjects } from '~/data/portfolio';

const metadata = {
  title: `${portfolioProfile.name} | ${portfolioProfile.role}`,
  description: portfolioProfile.intro,
  ignoreTitleTemplate: true,
};

const heroHeadlineLines = portfolioHome.hero.headline.split('\n');
const secondaryCta = portfolioHome.hero.secondaryCta;
const directLinks = portfolioActionLinks;
const selectedProjects = portfolioProjects.slice(0, 3);
const labProject = secondaryProjects[0];
const getLinkActionLabel = (item: (typeof directLinks)[number]) =>
  item.download ? '다운로드' : item.external ? '외부 링크' : '열기';

const signalCards = [
  {
    label: '집중 영역',
    value: '프로비저닝 / 배포 / 추적',
    tone: 'cyan',
  },
  {
    label: '실행 패턴',
    value: '요청 -> 실행 -> 기록',
    tone: 'green',
  },
  {
    label: '기술 스택',
    value: 'FastAPI / Terraform / Kubernetes / Actions',
    tone: 'slate',
  },
  {
    label: '프로젝트',
    value: selectedProjects.map((project) => project.title).join(' / '),
    tone: 'slate',
  },
];
---

<PageLayout metadata={metadata}>
  <section class="relative overflow-hidden border-b border-slate-800/80">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(6,182,212,0.12),transparent_32%),radial-gradient(circle_at_82%_14%,rgba(34,197,94,0.14),transparent_26%),linear-gradient(180deg,rgba(2,6,23,0.78),rgba(2,6,23,0))]"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-400/50 to-transparent"></div>

    <div class="portfolio-section relative !pb-12 md:!pb-16">
      <div class="grid gap-6 xl:grid-cols-12 xl:items-start">
        <div class="xl:col-span-7">
          <p class="portfolio-eyebrow text-cyan-300">{portfolioHome.hero.eyebrow}</p>
          <div class="mt-4">
            <p class="text-2xl font-semibold tracking-tight text-slate-50 sm:text-[2rem]">{portfolioProfile.name}</p>
            <p class="mt-2 text-sm font-medium uppercase tracking-[0.18em] text-slate-400">{portfolioProfile.role}</p>
          </div>

          <h1 class="mt-6 text-[clamp(2rem,4vw,3.8rem)] font-bold leading-[0.95] tracking-[-0.04em] text-slate-50">
            {heroHeadlineLines.map((line) => (
              <span class="block">{line}</span>
            ))}
          </h1>

          <p class="mt-6 max-w-[48rem] text-lg leading-8 text-slate-100/92 [text-wrap:pretty]">{portfolioHome.hero.lead}</p>
          <p class="mt-4 max-w-[44rem] text-base leading-7 text-slate-300/84 [text-wrap:pretty]">{portfolioHome.hero.supporting}</p>

          <div class="mt-6 flex flex-wrap gap-2.5">
            {portfolioHome.hero.featureChips.map((chip) => (
              <span class="rounded-full border border-slate-700/80 bg-slate-900/72 px-3 py-1.5 text-[11px] font-mono uppercase tracking-[0.16em] text-slate-200">
                {chip}
              </span>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <Button variant="primary" href={portfolioHome.hero.primaryCta.href}>
              {portfolioHome.hero.primaryCta.label}
            </Button>
            {secondaryCta ? (
              <Button
                variant="secondary"
                href={secondaryCta.href}
                class="px-4 py-2.5 text-sm md:px-5"
                {...(secondaryCta.download ? { download: true } : {})}
              >
                {secondaryCta.label}
              </Button>
            ) : null}
          </div>
        </div>

        <aside class="grid gap-3 sm:grid-cols-2 xl:col-span-5 xl:grid-cols-2">
          {signalCards.map((card) => (
            <article
              class:list={[
                'rounded-[1.35rem] border px-5 py-5',
                card.tone === 'green'
                  ? 'border-green-500/20 bg-green-950/10'
                  : card.tone === 'cyan'
                    ? 'border-cyan-500/20 bg-cyan-950/10'
                    : 'border-slate-800/80 bg-slate-950/62',
              ]}
            >
              <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-slate-400">{card.label}</p>
              <p class="mt-3 text-lg font-semibold tracking-tight text-slate-50 [text-wrap:balance]">{card.value}</p>
            </article>
          ))}
        </aside>

        <div id={portfolioHome.purposeSection.id} class="xl:col-span-12">
          <div class="grid auto-rows-fr gap-3 lg:grid-cols-3">
            {portfolioHome.purposeSection.cards.map((card) => (
              <article class="rounded-[1.45rem] border border-slate-800/80 bg-slate-950/62 p-5 sm:p-6">
                <p class="portfolio-eyebrow text-cyan-300">{card.title}</p>
                <p class="mt-4 text-base leading-7 text-slate-100/88 [text-wrap:pretty]">{card.description}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="xl:col-span-12">
          <div class="grid gap-3 xl:grid-cols-3">
            {selectedProjects.map((project, index) => (
              <a
                href={`#project-${project.slug}`}
                class="rounded-[1.45rem] border border-slate-800/80 bg-slate-950/62 p-5 transition hover:border-green-500/30 hover:bg-slate-950/82"
              >
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-slate-500">0{index + 1}</p>
                    <h2 class="mt-3 text-2xl font-semibold tracking-tight text-slate-50">{project.title}</h2>
                  </div>
                  <span class="rounded-full border border-slate-700/80 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.16em] text-slate-300">
                    {project.projectType}
                  </span>
                </div>
                <p class="mt-4 text-sm leading-6 text-slate-300/84 [text-wrap:pretty]">{project.resultLine}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id={portfolioHome.approachSection.id} class="border-b border-slate-800/70 bg-slate-950/40">
    <div class="portfolio-section-tight">
      <div class="flex flex-col gap-3">
        <p class="portfolio-eyebrow text-green-300">{portfolioHome.approachSection.eyebrow}</p>
        <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
          <h2 class="max-w-[34rem] text-[2rem] font-bold tracking-tight text-slate-50 sm:text-[2.4rem] sm:leading-[1.02]">
            {portfolioHome.approachSection.title}
          </h2>
          <p class="max-w-[36rem] text-base leading-7 text-slate-300/82 [text-wrap:pretty]">{portfolioHome.approachSection.description}</p>
        </div>
      </div>

      <div class="mt-6 grid gap-3 lg:grid-cols-3">
        {portfolioHome.approachSection.cards.map((card) => (
          <article class="rounded-[1.45rem] border border-slate-800/80 bg-slate-950/62 p-5 sm:p-6">
            <div class="flex h-12 w-12 items-center justify-center rounded-[1rem] border border-green-500/20 bg-green-950/10 text-base font-mono text-green-300">
              {card.index}
            </div>
            <h3 class="mt-5 text-xl font-semibold tracking-tight text-slate-50">{card.title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-300/84 [text-wrap:pretty]">{card.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id={portfolioHome.projectsSection.id} class="portfolio-anchor-section-tight">
    <div class="flex flex-col gap-3">
      <p class="portfolio-eyebrow text-cyan-300">{portfolioHome.projectsSection.eyebrow}</p>
      <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
        <h2 class="text-[2rem] font-bold tracking-tight text-slate-50 sm:text-[2.4rem] sm:leading-[1.02]">
          {portfolioHome.projectsSection.title}
        </h2>
        <p class="max-w-[36rem] text-base leading-7 text-slate-300/82 [text-wrap:pretty]">{portfolioHome.projectsSection.description}</p>
      </div>
    </div>

    <div class="mt-8 grid gap-5">
      {mainProjects[0] ? (
        <div id={`project-${mainProjects[0].slug}`}>
          <HomeProjectSpotlightCard project={mainProjects[0]} />
        </div>
      ) : null}

      <div class="grid gap-5 xl:grid-cols-2">
        {mainProjects[1] ? (
          <div id={`project-${mainProjects[1].slug}`}>
            <HomeProjectSpotlightCard project={mainProjects[1]} compact />
          </div>
        ) : null}

        {labProject ? (
          <div id={`project-${labProject.slug}`}>
            <HomeProjectSpotlightCard project={labProject} compact />
          </div>
        ) : null}
      </div>
    </div>
  </section>

  {directLinks.length ? (
    <section id={portfolioHome.contactSection.id} class="border-t border-slate-800/70 portfolio-anchor-section-tight">
      <div class="flex flex-col gap-3">
        <p class="portfolio-eyebrow text-green-300">{portfolioHome.contactSection.eyebrow}</p>
        <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
          <h2 class="text-[2rem] font-bold tracking-tight text-slate-50 sm:text-[2.2rem] sm:leading-[1.02]">
            {portfolioHome.contactSection.title}
          </h2>
          <p class="max-w-[30rem] text-base leading-7 text-slate-300/82 [text-wrap:pretty]">{portfolioHome.contactSection.description}</p>
        </div>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {directLinks.map((item) => (
          <a
            class="flex h-full flex-col justify-between gap-4 rounded-[1.35rem] border border-slate-800/80 bg-slate-950/62 p-5 transition hover:border-green-500/30 hover:bg-slate-950/84"
            href={item.href}
            {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            {...(item.download ? { download: true } : {})}
          >
            <div>
              <p class="portfolio-eyebrow text-cyan-300">{item.label}</p>
              <p class="mt-3 text-sm leading-6 text-slate-100/90 [text-wrap:pretty]">{item.description}</p>
            </div>
            <span class="text-xs font-mono uppercase tracking-[0.16em] text-slate-500">{getLinkActionLabel(item)}</span>
          </a>
        ))}
      </div>
    </section>
  ) : null}
</PageLayout>
