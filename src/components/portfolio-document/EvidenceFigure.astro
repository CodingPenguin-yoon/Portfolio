---
import type { EvidenceStatus } from '~/data/portfolio-document';

export interface Props {
  src: string;
  alt: string;
  caption: string;
  status: EvidenceStatus;
  source?: string;
  focus?: {
    id: string;
    label: string;
  };
}

const { src, alt, caption, status, source, focus } = Astro.props;

const evidenceStatusLabels: Record<EvidenceStatus, string> = {
  verified: '저장소 검증',
  'user-confirmed': '사용자 확인',
  planned: '계획 근거',
};
---

<figure class="evidence-figure" data-evidence-status={status} data-evidence-presentation={focus && 'focused-detail'}>
  <div class="evidence-media" data-evidence-focus={focus?.id} aria-label={focus?.label} role={focus && 'group'}>
    <img src={src} alt={alt} loading="eager" />
  </div>
  <figcaption>
    <span class="evidence-status">{evidenceStatusLabels[status]}</span>
    <strong>{caption}</strong>
    {source && <span class="evidence-source">{source}</span>}
  </figcaption>
</figure>
