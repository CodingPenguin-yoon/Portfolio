---
import '@fontsource/ibm-plex-sans-kr/400.css';
import '@fontsource/ibm-plex-sans-kr/500.css';
import '@fontsource/ibm-plex-sans-kr/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
---

<style is:inline>
  @font-face {
    font-family: 'DungGeunMo';
    src: url('https://fastly.jsdelivr.net/gh/projectnoonnu/noonfonts_six@1.2/DungGeunMo.woff') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --aw-font-sans: 'IBM Plex Sans KR';
    --aw-font-serif: 'IBM Plex Sans KR';
    --aw-font-heading: 'DungGeunMo';
    --aw-font-mono: 'IBM Plex Mono', monospace;
    --aw-header-offset: 88px;
    --aw-anchor-offset: calc(var(--aw-header-offset) + 1.5rem);

    /* Terminal green/cyan accent */
    --aw-color-primary: rgb(34 197 94);
    --aw-color-secondary: rgb(22 163 74);
    --aw-color-accent: rgb(6 182 212);

    /* Dark background */
    --aw-color-bg-page: rgb(2 6 23);
    --aw-color-bg-page-dark: rgb(15 23 42);

    /* Light text */
    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(148 163 184);

    ::selection {
      background-color: rgb(34 197 94 / 0.3);
      color: rgb(248 250 252);
    }
  }

  html {
    background-color: rgb(2 6 23);
    scroll-behavior: smooth;
    scroll-padding-top: var(--aw-anchor-offset);
  }

  body {
    background:
      radial-gradient(circle at top, rgb(34 197 94 / 0.08), transparent 0%, transparent 36%),
      radial-gradient(circle at 82% 10%, rgb(6 182 212 / 0.08), transparent 0%, transparent 24%),
      linear-gradient(180deg, rgb(2 6 23) 0%, rgb(6 11 25) 32%, rgb(15 23 42) 100%);
    font-family: var(--aw-font-sans), sans-serif;
    line-height: 1.65;
    letter-spacing: -0.01em;
    min-height: 100vh;
  }

  main :where(section[id], article[id], div[id]) {
    scroll-margin-top: var(--aw-anchor-offset);
  }

  .portfolio-anchor-section {
    scroll-margin-top: var(--aw-anchor-offset);
  }

  .dark {
    --aw-font-sans: 'IBM Plex Sans KR';
    --aw-font-serif: 'IBM Plex Sans KR';
    --aw-font-heading: 'DungGeunMo';
    --aw-font-mono: 'IBM Plex Mono', monospace;

    /* Terminal green/cyan accent */
    --aw-color-primary: rgb(34 197 94);
    --aw-color-secondary: rgb(22 163 74);
    --aw-color-accent: rgb(6 182 212);

    /* Dark background */
    --aw-color-bg-page: rgb(15 23 42);
    --aw-color-bg-page-dark: rgb(30 41 59);

    /* Light text */
    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(148 163 184);

    ::selection {
      background-color: rgb(34 197 94 / 0.3);
      color: rgb(248 250 252);
    }
  }

  /* Terminal cursor blink animation */
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .terminal-cursor {
    animation: blink 1s step-end infinite;
  }

  :where(a, button, summary, input, textarea, select, [tabindex]):focus-visible {
    outline: 2px solid rgb(74 222 128 / 0.95);
    outline-offset: 3px;
  }

  :where(main) {
    isolation: isolate;
  }

  h1,
  h2,
  h3,
  .font-heading {
    letter-spacing: 0.01em;
  }

  @media (max-width: 767px) {
    body {
      font-size: 16.5px;
      line-height: 1.72;
    }
  }
</style>
