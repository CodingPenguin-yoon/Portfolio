---
import type {
  ArchitectureConnectionData,
  ArchitectureConnectionStatus,
  ArchitectureZoneData,
} from '~/data/portfolio-document';

export interface Props {
  zones: readonly ArchitectureZoneData[];
  connections: readonly ArchitectureConnectionData[];
  label: string;
  caption?: string;
}

const { zones, connections, label, caption } = Astro.props;

const connectionStatusLabels: Record<ArchitectureConnectionStatus, string> = {
  active: '현재 연결',
  operational: '운영 연결',
  planned: '계획 연결',
  external: '외부 경계',
};

const zonesById = new Map(zones.map((zone) => [zone.id, zone] as const));
const resolvedConnections = connections.map((connection) => {
  const fromZone = zonesById.get(connection.fromZoneId);
  const toZone = zonesById.get(connection.toZoneId);

  if (!fromZone || !toZone) {
    throw new Error(
      `Architecture connection references an unknown zone: ${connection.fromZoneId} → ${connection.toZoneId}`
    );
  }

  return { ...connection, fromLabel: fromZone.label, toLabel: toZone.label };
});
---

<figure class="architecture-map" data-architecture-map aria-label={label}>
  <p class="diagram-label">{label}</p>
  <div class="architecture-zones">
    {
      zones.map((zone) => (
        <section class="architecture-zone" data-architecture-zone={zone.id} data-system-node={zone.systemNode}>
          <h3>{zone.label}</h3>
          <p>{zone.responsibility}</p>
          {zone.details && (
            <ul class="architecture-zone-details" aria-label={`${zone.label} 구성`}>
              {zone.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          )}
          {zone.operationalNote && <p class="architecture-operational-note">{zone.operationalNote}</p>}
        </section>
      ))
    }
  </div>
  <ul class="architecture-connections" aria-label="영역 간 연결 상태">
    {
      resolvedConnections.map((connection) => (
        <li
          data-connection-status={connection.status}
          data-from-zone={connection.fromZoneId}
          data-to-zone={connection.toZoneId}
        >
          <span class="connection-route" aria-label={`${connection.fromLabel}에서 ${connection.toLabel}로 연결`}>
            <strong>{connection.fromLabel}</strong>
            <span class="connection-edge" data-connection-edge aria-hidden="true" />
            <strong>{connection.toLabel}</strong>
          </span>
          <span>{connection.label}</span>
          <span class="connection-status">{connectionStatusLabels[connection.status]}</span>
        </li>
      ))
    }
  </ul>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
